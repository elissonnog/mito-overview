# Minimal standalone BAM example. Paths are resolved relative to this file.
WORK_ROOT=/tmp/mito_overview_standalone_runs
RUN_NAME=mito_STANDALONE_SAMPLE
SAMPLE_ID=STANDALONE_SAMPLE
REF_FASTA=/path/to/reference.fa
SOURCE_ALIGN_FILE=/path/to/alignment.bam
MT_CONTIG=MT

# The FASTA must have a .fai and the BAM must have a .bai. SOURCE_ALIGN_MODE
# and MT_LENGTH are inferred from those inputs.
READ_MODE=long
ASSAY_TYPE=wgs
REFERENCE_SCOPE=auto

MIN_CALLABLE_DEPTH=100
MIN_ALT_ALLELE_FRACTION=0.02
ALLELE_MIN_BASE_QUALITY=13
ALLELE_MIN_MAPPING_QUALITY=20
ALLELE_MIN_READ_MEAN_QUALITY=10
ALLELE_MAX_DEPTH=0
ALLELE_EXCLUDE_FLAGS=3844
ALLELE_IGNORE_OVERLAPS=1

# Optional enrichment remains offline unless explicitly enabled.
MVTOOL_MODE=disabled
